{
  "name": "png-to-gif",
  "version": "1.0.0",
  "description": "PNG to GIF converter",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron src/main/main.js",
    "dev": "npm start",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac --arm64",
    "postinstall": "node scripts/setup-imagemagick.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.4.0"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "gif-encoder-2": "^1.0.5",
    "image-js": "^0.35.3",
    "png-file-stream": "^1.2.1",
    "png-js": "^1.0.0",
    "sharp": "^0.32.6"
  },
  "build": {
    "appId": "com.png-to-gif-converter",
    "productName": "PNG to GIF Converter",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/**/prebuilds/linux*",
      "!node_modules/**/prebuilds/win32*"
    ],
    "extraResources": [
      { "from": "vendor/gifski/gifski", "to": "gifski" },
      { "from": "vendor/gifsicle/gifsicle", "to": "gifsicle" }
    ],
    "directories": {
      "buildResources": "src/assets"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "This app requires Apple Events permission to function properly.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "NSCameraUsageDescription": "This app does not use the camera."
      }
    },
    "win": {
      "target": "portable"
    },
    "afterPack": "./scripts/afterPack.js"
  }
}

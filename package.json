{
  "name": "png-to-gif",
  "version": "1.0.0",
  "description": "PNG to GIF converter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.4.0"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "gif-encoder-2": "^1.0.5",
    "image-js": "^0.35.3",
    "png-file-stream": "^1.2.1",
    "png-js": "^1.0.0",
    "sharp": "^0.32.6"
  },
  "build": {
    "appId": "com.png-to-gif-converter",
    "productName": "PNG to GIF Converter",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "portable"
    }
  }
}
